parameters:
    level: 8
    paths:
        - packages/core/component-engine/src
        - packages/core/orm/src
        - packages/core/push-hub/src
        - packages/core/typing-contracts/src
        - packages/core/queue/src
        - packages/devtools/dev-server/src
        - packages/core/store/src
        - packages/devtools/debugbar/src
        - packages/core/security/src
        - packages/core/auth/src
        - packages/core/validation/src
        - packages/core/http/src
        - packages/core/config/src
        - packages/core/authorization/src
        - packages/bridge/adapter/src
        - packages/framework/kernel/src
    # HubServer::run() / Worker::run() are intentionally long-lived daemon loops.
    ignoreErrors:
        -
            message: '#While loop condition is always true#'
            path: packages/core/push-hub/src/HubServer.php
        -
            message: '#While loop condition is always true#'
            path: packages/core/queue/src/Worker.php
