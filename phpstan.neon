parameters:
    level: 8
    paths:
        - packages/core/component-engine/src
        - packages/core/orm/src
        - packages/core/push-hub/src
        - packages/core/typing-contracts/src
        - packages/core/queue/src
        - packages/devtools/dev-server/src
        - packages/core/store/src
        - packages/devtools/debugbar/src
        - packages/core/security/src
        - packages/core/auth/src
        - packages/core/validation/src
        - packages/core/http/src
        - packages/core/config/src
        - packages/core/authorization/src
        - packages/core/mail/src
        - packages/core/logging/src
        - packages/core/error-handler/src
        - packages/core/cache/src
        - packages/core/console/src
        - packages/core/testing/src
        - packages/core/container/src
        - packages/core/templating/src
        - packages/core/rate-limiting/src
        - packages/core/events/src
        - packages/core/notifications/src
        - packages/core/storage/src
        - packages/bridge/adapter/src
        - packages/framework/kernel/src
    ignoreErrors:
        # HubServer::run() / Worker::run() are intentionally long-lived daemon loops.
        -
            message: '#While loop condition is always true#'
            path: packages/core/push-hub/src/HubServer.php
        -
            message: '#While loop condition is always true#'
            path: packages/core/queue/src/Worker.php
        # View::render()'s pendingLayout check looks always-null/unreachable to
        # PHPStan because the mutation happens inside a dynamically include()'d
        # compiled template calling back into $this->extend() — invisible to
        # static analysis, but real at runtime (proven by ViewTest's
        # extends/section/yield tests actually executing that path).
        -
            message: '#will always evaluate to true#'
            path: packages/core/templating/src/View.php
        -
            message: '#Unreachable statement#'
            path: packages/core/templating/src/View.php
