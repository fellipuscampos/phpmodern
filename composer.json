{
    "name": "phpmodern/workspace",
    "description": "Dev workspace for the phpmodern framework packages (monorepo, not published as-is).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.2",
        "phpmodern/component-engine": "*",
        "phpmodern/orm": "*",
        "phpmodern/push-hub": "*",
        "phpmodern/bridge-adapter": "*",
        "phpmodern/kernel": "*",
        "phpmodern/typing-contracts": "*",
        "phpmodern/queue": "*",
        "phpmodern/dev-server": "*",
        "phpmodern/store": "*",
        "phpmodern/debugbar": "*",
        "phpmodern/security": "*",
        "phpmodern/auth": "*",
        "phpmodern/validation": "*",
        "phpmodern/http": "*",
        "phpmodern/config": "*",
        "phpmodern/authorization": "*",
        "phpmodern/mail": "*",
        "phpmodern/logging": "*",
        "phpmodern/error-handler": "*",
        "phpmodern/cache": "*",
        "phpmodern/console": "*",
        "phpmodern/testing": "*",
        "phpmodern/container": "*",
        "phpmodern/templating": "*",
        "phpmodern/rate-limiting": "*"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*/*"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "PhpModern\\ComponentEngine\\Tests\\": "packages/core/component-engine/tests/",
            "PhpModern\\Orm\\Tests\\": "packages/core/orm/tests/",
            "PhpModern\\PushHub\\Tests\\": "packages/core/push-hub/tests/",
            "PhpModern\\TypingContracts\\Tests\\": "packages/core/typing-contracts/tests/",
            "PhpModern\\Kernel\\Tests\\": "packages/framework/kernel/tests/",
            "PhpModern\\Queue\\Tests\\": "packages/core/queue/tests/",
            "PhpModern\\DevServer\\Tests\\": "packages/devtools/dev-server/tests/",
            "PhpModern\\Store\\Tests\\": "packages/core/store/tests/",
            "PhpModern\\DebugBar\\Tests\\": "packages/devtools/debugbar/tests/",
            "PhpModern\\Security\\Tests\\": "packages/core/security/tests/",
            "PhpModern\\Auth\\Tests\\": "packages/core/auth/tests/",
            "PhpModern\\Validation\\Tests\\": "packages/core/validation/tests/",
            "PhpModern\\Http\\Tests\\": "packages/core/http/tests/",
            "PhpModern\\Config\\Tests\\": "packages/core/config/tests/",
            "PhpModern\\Authorization\\Tests\\": "packages/core/authorization/tests/",
            "PhpModern\\Mail\\Tests\\": "packages/core/mail/tests/",
            "PhpModern\\Logging\\Tests\\": "packages/core/logging/tests/",
            "PhpModern\\ErrorHandler\\Tests\\": "packages/core/error-handler/tests/",
            "PhpModern\\Cache\\Tests\\": "packages/core/cache/tests/",
            "PhpModern\\Console\\Tests\\": "packages/core/console/tests/",
            "PhpModern\\Testing\\Tests\\": "packages/core/testing/tests/",
            "PhpModern\\Container\\Tests\\": "packages/core/container/tests/",
            "PhpModern\\Templating\\Tests\\": "packages/core/templating/tests/",
            "PhpModern\\RateLimiting\\Tests\\": "packages/core/rate-limiting/tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text --coverage-html var/coverage-html",
        "analyse": "phpstan analyse --memory-limit=512M"
    }
}
