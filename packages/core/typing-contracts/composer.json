{
    "name": "phpmodern/typing-contracts",
    "description": "The TypeScript-equivalent pillar: a PHPStan rule that bans untyped/mixed component props, plus a zero-config `check` command.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "phpmodern/component-engine": "*",
        "phpmodern/dev-server": "*",
        "phpstan/phpstan": "^2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "PhpModern\\TypingContracts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpModern\\TypingContracts\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/phpmodern-check"
    ]
}
