#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * See packages/core/queue/bin/worker.php for why this searches from getcwd()
 * first: a path-repository install junctions this file into the consuming
 * project's vendor tree, so __DIR__ alone can resolve to this file's
 * physical location inside the phpmodern monorepo instead — which would
 * silently miss the app's own classes (e.g. its migrations' namespace).
 */
function phpmodern_console_find_upwards(string $startDir, string $relative): ?string
{
    $dir = $startDir;

    for ($i = 0; $i < 10; $i++) {
        $candidate = $dir . DIRECTORY_SEPARATOR . $relative;
        if (is_file($candidate)) {
            return $candidate;
        }

        $parent = dirname($dir);
        if ($parent === $dir) {
            break;
        }

        $dir = $parent;
    }

    return null;
}

$autoload = phpmodern_console_find_upwards(getcwd(), 'vendor/autoload.php');

if ($autoload === null) {
    foreach ([__DIR__ . '/../../../../vendor/autoload.php', __DIR__ . '/../vendor/autoload.php'] as $candidate) {
        if (is_file($candidate)) {
            $autoload = $candidate;

            break;
        }
    }
}

if ($autoload === null) {
    fwrite(STDERR, "Could not locate vendor/autoload.php — run this from your project (or run composer install first).\n");
    exit(1);
}

require $autoload;

use PhpModern\Config\Config;
use PhpModern\Config\Env;
use PhpModern\Kernel\Console\MakeComponentCommand;
use PhpModern\Orm\Connection;
use PhpModern\Orm\MigrationRunner;

Env::load(getcwd() . '/.env'); // a real environment variable always wins over this

/** @param list<string> $args */
function console_options(array $args): array
{
    $options = [];

    foreach ($args as $arg) {
        if (str_starts_with($arg, '--') && str_contains($arg, '=')) {
            [$key, $value] = explode('=', substr($arg, 2), 2);
            $options[$key] = $value;
        }
    }

    return $options;
}

/** @var list<string> $argv */
$command = $argv[1] ?? null;

if ($command === 'make:component') {
    $name = $argv[2] ?? null;

    if ($name === null) {
        fwrite(STDERR, "Usage: console make:component <Name> [--dir=app/Components] [--namespace=App\\Components]\n");
        exit(1);
    }

    $options = console_options(array_slice($argv, 3));
    $targetDir = getcwd() . '/' . ($options['dir'] ?? 'app/Components');
    $namespace = $options['namespace'] ?? 'App\\Components';

    try {
        $path = (new MakeComponentCommand())->run($name, $targetDir, $namespace);
        fwrite(STDOUT, "Created: {$path}\n");
        exit(0);
    } catch (Throwable $exception) {
        fwrite(STDERR, $exception->getMessage() . "\n");
        exit(1);
    }
}

if ($command === 'migrate' || $command === 'migrate:rollback') {
    $options = console_options(array_slice($argv, 2));
    $dsn = $options['dsn'] ?? Config::string('DATABASE_URL');
    $migrationsDir = getcwd() . '/' . ($options['dir'] ?? 'database/migrations');

    if ($dsn === null) {
        fwrite(STDERR, "Missing database DSN. Pass --dsn=sqlite:path/to.db or set the DATABASE_URL environment variable.\n");
        exit(1);
    }

    try {
        $runner = new MigrationRunner(new Connection($dsn));

        if ($command === 'migrate') {
            $applied = $runner->run($migrationsDir);

            if ($applied === []) {
                fwrite(STDOUT, "Nothing to migrate.\n");
            } else {
                foreach ($applied as $name) {
                    fwrite(STDOUT, "Migrated: {$name}\n");
                }
            }

            exit(0);
        }

        $rolledBack = $runner->rollbackLast($migrationsDir);
        fwrite(STDOUT, $rolledBack === null ? "Nothing to roll back.\n" : "Rolled back: {$rolledBack}\n");
        exit(0);
    } catch (Throwable $exception) {
        fwrite(STDERR, $exception->getMessage() . "\n");
        exit(1);
    }
}

fwrite(STDOUT, "phpmodern kernel console\n\n");
fwrite(STDOUT, "Commands:\n");
fwrite(STDOUT, "  make:component <Name>   Scaffold a new typed component (App\\Components\\<Name>)\n");
fwrite(STDOUT, "  migrate                 Run pending migrations from database/migrations\n");
fwrite(STDOUT, "  migrate:rollback        Roll back the most recently applied migration\n");
fwrite(STDOUT, "\nBoth migrate commands accept --dsn=... (or DATABASE_URL) and --dir=...\n");
