#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * See packages/core/queue/bin/worker.php for why this searches from getcwd()
 * first: a path-repository install junctions this file into the consuming
 * project's vendor tree, so __DIR__ alone can resolve to this file's
 * physical location inside the phpmodern monorepo instead — which would
 * silently miss the app's own classes (e.g. its migrations' namespace).
 */
function phpmodern_console_find_upwards(string $startDir, string $relative): ?string
{
    $dir = $startDir;

    for ($i = 0; $i < 10; $i++) {
        $candidate = $dir . DIRECTORY_SEPARATOR . $relative;
        if (is_file($candidate)) {
            return $candidate;
        }

        $parent = dirname($dir);
        if ($parent === $dir) {
            break;
        }

        $dir = $parent;
    }

    return null;
}

$autoload = phpmodern_console_find_upwards(getcwd(), 'vendor/autoload.php');

if ($autoload === null) {
    foreach ([__DIR__ . '/../../../../vendor/autoload.php', __DIR__ . '/../vendor/autoload.php'] as $candidate) {
        if (is_file($candidate)) {
            $autoload = $candidate;

            break;
        }
    }
}

if ($autoload === null) {
    fwrite(STDERR, "Could not locate vendor/autoload.php — run this from your project (or run composer install first).\n");
    exit(1);
}

require $autoload;

use PhpModern\Config\Env;
use PhpModern\Console\Application;
use PhpModern\Kernel\Console\MakeComponentConsoleCommand;
use PhpModern\Kernel\Console\MigrateConsoleCommand;
use PhpModern\Kernel\Console\MigrateRollbackConsoleCommand;
use PhpModern\Kernel\Console\SeedConsoleCommand;

Env::load(getcwd() . '/.env'); // a real environment variable always wins over this

$app = new Application('phpmodern kernel console');
$app->register(new MakeComponentConsoleCommand());
$app->register(new MigrateConsoleCommand());
$app->register(new MigrateRollbackConsoleCommand());
$app->register(new SeedConsoleCommand());

/** @var list<string> $argv */
exit($app->run($argv));
